  SELECT
      at as timestamp,
      getSubcolumn(data_json, 'projectId') as projectId,
      getSubcolumn(data_json, 'ownerId') as ownerId,
      getSubcolumn(data_json, 'gatewayApiKeyId') as keyId,
      getSubcolumn(data_json, 'authMethod') :: LowCardinality(String) as authMethod,
      -- Dimensions
      getSubcolumn(data_json, 'referringSiteUrl') as referrerUrl,
      getSubcolumn(data_json, 'referringSiteName') as appName,
      getSubcolumn(data_json, 'environment') as environment,
      getSubcolumn(data_json, 'deploymentId') as deploymentId,
      getSubcolumn(data_json, 'gatewayModelId') :: LowCardinality(String) as gatewayModelId,
      getSubcolumn(data_json, 'model') :: LowCardinality(String) as model,
      getSubcolumn(data_json, 'modelType') :: LowCardinality(String) as modelType,
      getSubcolumn(data_json, 'servedSpeed') :: LowCardinality(String) as servedSpeed,
      getSubcolumn(data_json, 'provider') :: LowCardinality(String) as provider,
      getSubcolumn(data_json, 'currency') :: LowCardinality(String) as currency,
      getSubcolumn(data_json, 'marketCostCurrency') :: LowCardinality(String) as marketCostCurrency,
      getSubcolumn(data_json, 'inputCostPerTokenCurrency') :: LowCardinality(String) as inputCostPerTokenCurrency,
      getSubcolumn(data_json, 'outputCostPerTokenCurrency') :: LowCardinality(String) as outputCostPerTokenCurrency,
      getSubcolumn(data_json, 'cachedInputTokensCostCurrency') :: LowCardinality(String) as cachedInputTokensCurrency,
      getSubcolumn(data_json, 'cacheCreationInputTokensCostCurrency') :: LowCardinality(String) as cacheCreationInputTokensCurrency,
      getSubcolumn(data_json, 'cacheCreation1hInputTokensCostCurrency') :: LowCardinality(String) as cacheCreation1hInputTokensCurrency,
      getSubcolumn(data_json, 'surchargeCostCurrency') :: LowCardinality(String) as surchargeCostCurrency,
      getSubcolumn(data_json, 'gatewayCostCurrency') :: LowCardinality(String) as gatewayCostCurrency,
      if(isNotNull(getSubcolumn(data_json, 'addedCreditCard')), if(assumeNotNull(getSubcolumn(data_json, 'addedCreditCard')), 'card-present', 'no-card-present'), 'unknown') :: LowCardinality(String) as addedCreditCard,
      if(isNotNull(getSubcolumn(data_json, 'isFreeTier')), if(assumeNotNull(getSubcolumn(data_json, 'isFreeTier')), 'free-tier', 'paid-tier'), 'unknown') :: LowCardinality(String) as isFreeTier,
      if(isNotNull(getSubcolumn(data_json, 'isByok')), if(assumeNotNull(getSubcolumn(data_json, 'isByok')), 'byok', 'not-byok'), 'unknown') :: LowCardinality(String) as isByok,
      if(isNotNull(getSubcolumn(data_json, 'isPrivateModel')), if(assumeNotNull(getSubcolumn(data_json, 'isPrivateModel')), 'private-model', 'not-private-model'), 'unknown') :: LowCardinality(String) as isPrivateModel,
      if(isNotNull(getSubcolumn(data_json, 'isStreaming')), if(assumeNotNull(getSubcolumn(data_json, 'isStreaming')), 'streamed', 'generated'), 'unknown') :: LowCardinality(String) as isStreaming,
      if(isNotNull(getSubcolumn(data_json, 'isRequestZdr')), if(assumeNotNull(getSubcolumn(data_json, 'isRequestZdr')), 'zdr-requested', 'no-zdr-requested'), 'unknown') :: LowCardinality(String) as isRequestZdr,
      if(isNotNull(getSubcolumn(data_json, 'hipaaRequested')), if(assumeNotNull(getSubcolumn(data_json, 'hipaaRequested')), 'hipaa-requested', 'no-hipaa-requested'), 'unknown') :: LowCardinality(String) as hipaaRequested,
      if(isNotNull(getSubcolumn(data_json, 'quotaRequested')), if(assumeNotNull(getSubcolumn(data_json, 'quotaRequested')), 'quota-requested', 'no-quota-requested'), 'unknown') :: LowCardinality(String) as quotaRequested,
      if(isNotNull(getSubcolumn(data_json, 'evaluationFallbackConfigured')), if(assumeNotNull(getSubcolumn(data_json, 'evaluationFallbackConfigured')), 'fallback-configured', 'no-fallback-configured'), 'unknown') :: LowCardinality(String) as evaluationFallbackConfigured,
      if(isNotNull(getSubcolumn(data_json, 'evaluationFallbackTriggered')), if(assumeNotNull(getSubcolumn(data_json, 'evaluationFallbackTriggered')), 'fallback-triggered', 'fallback-not-triggered'), 'unknown') :: LowCardinality(String) as evaluationFallbackTriggered,
      getSubcolumn(data_json, 'evaluationFallbackStage') :: LowCardinality(String) as evaluationFallbackStage,
      getSubcolumn(data_json, 'quotaEntityId') as quotaEntityId,
      getSubcolumn(data_json, 'quotaEntityType') :: LowCardinality(String) as quotaEntityType,
      getSubcolumn(data_json, 'generationId') as generationId,
      getSubcolumn(data_json, 'gatewayRequestId') as gatewayRequestId,
      getSubcolumn(data_json, 'finishReason') as finishReason,
      getSubcolumn(data_json, 'userId') as userId,
      getSubcolumn(data_json, 'spendAttribution') :: LowCardinality(String) as spendAttribution,
      JSONExtract(getSubcolumn(data_json, 'tags'), 'Array(String)') as tags,
      getSubcolumn(data_json, 'userAgent') as userAgent,
      getSubcolumn(data_json, 'codingAgent') :: LowCardinality(String) as codingAgent,
      getSubcolumn(data_json, 'requestApiFormat') :: LowCardinality(String) as requestApiFormat,
      getSubcolumn(data_json, 'vmcModelId') as vmcModelId,
      getSubcolumn(data_json, 'vmcKind') :: LowCardinality(String) as vmcKind,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'vmcByokCredentialIds'))) as vmcByokCredentialIds,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'vmcProviderOrder'))) as vmcProviderOrder,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'vmcProviderOnly'))) as vmcProviderOnly,
      JSONExtract(getSubcolumn(data_json, 'vmcInferenceRegion'), 'Map(String, String)') as vmcInferenceRegion,
      getSubcolumn(data_json, 'routerSelector') :: LowCardinality(String) as routerSelector,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'routerCandidates'))) as routerCandidates,
      if(isNotNull(getSubcolumn(data_json, 'routerExcluded')), assumeNotNull(getSubcolumn(data_json, 'routerExcluded')), '[]') as routerExcluded,
      if(isNotNull(getSubcolumn(data_json, 'routerPruned')), assumeNotNull(getSubcolumn(data_json, 'routerPruned')), '[]') as routerPruned,
      if(isNotNull(getSubcolumn(data_json, 'routerAttempts')), assumeNotNull(getSubcolumn(data_json, 'routerAttempts')), '[]') as routerAttempts,
      if(isNotNull(getSubcolumn(data_json, 'routerPrunedProviders')), assumeNotNull(getSubcolumn(data_json, 'routerPrunedProviders')), '[]') as routerPrunedProviders,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'requestProviderOnly'))) as requestProviderOnly,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'requestProviderOrder'))) as requestProviderOrder,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'requiredCapabilities'))) as requiredCapabilities,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'appliedPremiums'))) as appliedPremiums,
      arrayMap(x -> trim(BOTH '"' FROM x), JSONExtractArrayRaw(getSubcolumn(data_json, 'appliedRuleIds'))) as appliedRuleIds,
      getSubcolumn(data_json, 'sortOption') :: LowCardinality(String) as sortOption,
      getSubcolumn(data_json, 'byokCredentialId') as byokCredentialId,
      getSubcolumn(data_json, 'region') :: LowCardinality(String) as region,
      getSubcolumn(data_json, 'teamSlug') as teamSlug,
      getSubcolumn(data_json, 'teamName') as teamName,
      getSubcolumn(data_json, 'teamPlanType') :: LowCardinality(String) as teamPlanType,
      getSubcolumn(data_json, 'billingStatus') :: LowCardinality(String) as billingStatus,
      getSubcolumn(data_json, 'serviceTier') :: LowCardinality(String) as serviceTier,
      getSubcolumn(data_json, 'vercelId') as requestId,
      getSubcolumn(data_json, 'sessionId') as sessionId,
      getSubcolumn(data_json, 'ipAddress') as ipAddress,
      getSubcolumn(data_json, 'geoCountry') :: LowCardinality(String) as geoCountry,
      getSubcolumn(data_json, 'geoCountryRegion') :: LowCardinality(String) as geoCountryRegion,
      getSubcolumn(data_json, 'geoCity') as geoCity,
      getSubcolumn(data_json, 'contentCaptureStatus') as contentCaptureStatus,
      if(isNotNull(getSubcolumn(data_json, 'contentCaptureInputs')), assumeNotNull(getSubcolumn(data_json, 'contentCaptureInputs')), '[]') as contentCaptureInputs,
      if(isNotNull(getSubcolumn(data_json, 'contentCaptureOutputs')), assumeNotNull(getSubcolumn(data_json, 'contentCaptureOutputs')), '[]') as contentCaptureOutputs,
      getSubcolumn(data_json, 'transcriptStatus') as transcriptStatus,
      if(isNotNull(getSubcolumn(data_json, 'transcriptInputs')), assumeNotNull(getSubcolumn(data_json, 'transcriptInputs')), '[]') as transcriptInputs,
      if(isNotNull(getSubcolumn(data_json, 'transcriptOutputs')), assumeNotNull(getSubcolumn(data_json, 'transcriptOutputs')), '[]') as transcriptOutputs,
      getSubcolumn(data_json, 'inferenceEndpointSlug') :: LowCardinality(String) as inferenceEndpointSlug,
      getSubcolumn(data_json, 'inferenceScope') :: LowCardinality(String) as inferenceScope,
      getSubcolumn(data_json, 'inferenceGeoRegion') :: LowCardinality(String) as inferenceGeoRegion,
      getSubcolumn(data_json, 'inferenceProviderRegion') :: LowCardinality(String) as inferenceProviderRegion,
      getSubcolumn(data_json, 'requestedInferenceRegion') as requestedInferenceRegion,
      -- Measures
      if(isNotNull(getSubcolumn(data_json, 'cost')), assumeNotNull(getSubcolumn(data_json, 'cost')), getSubcolumn(data_json, 'amount')) :: Decimal(38, 10) as cost,
      if(isNotNull(getSubcolumn(data_json, 'marketCost')), assumeNotNull(getSubcolumn(data_json, 'marketCost')), getSubcolumn(data_json, 'amount')) :: Decimal(38, 10) as marketCost,
      if(isNotNull(getSubcolumn(data_json, 'inputCostPerToken')) AND assumeNotNull(getSubcolumn(data_json, 'inputCostPerToken')) != '', assumeNotNull(getSubcolumn(data_json, 'inputCostPerToken')), '0') :: Decimal(38, 10) as inputCostPerToken,
      if(isNotNull(getSubcolumn(data_json, 'inputListCostPerToken')) AND assumeNotNull(getSubcolumn(data_json, 'inputListCostPerToken')) != '', assumeNotNull(getSubcolumn(data_json, 'inputListCostPerToken')), '0') :: Decimal(38, 10) as inputListCostPerToken,
      getSubcolumn(data_json, 'inputTokens') :: Int64 as inputTokens,
      if(isNotNull(getSubcolumn(data_json, 'outputCostPerToken')) AND assumeNotNull(getSubcolumn(data_json, 'outputCostPerToken')) != '', assumeNotNull(getSubcolumn(data_json, 'outputCostPerToken')), '0') :: Decimal(38, 10) as outputCostPerToken,
      if(isNotNull(getSubcolumn(data_json, 'outputListCostPerToken')) AND assumeNotNull(getSubcolumn(data_json, 'outputListCostPerToken')) != '', assumeNotNull(getSubcolumn(data_json, 'outputListCostPerToken')), '0') :: Decimal(38, 10) as outputListCostPerToken,
