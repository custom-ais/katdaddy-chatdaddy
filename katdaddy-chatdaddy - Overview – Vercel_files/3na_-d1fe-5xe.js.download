          getSubcolumn(data_json, 'clientRequestReferer') AS referrerUrl,
          domain(getSubcolumn(data_json, 'clientRequestReferer')) AS referrerHostname,
          getSubcolumn(data_json, 'responseStatus')::Int16 AS httpStatus,
          '' AS clientIp,
          getSubcolumn(data_json, 'clientRequestUserAgent') AS clientUserAgent,
          toLowCardinality(getSubcolumn(data_json, 'vercelRegion')) AS edgeNetworkRegion,
          toLowCardinality(getSubcolumn(data_json, 'computeRegion')) AS functionRegion,
          getSubcolumn(data_json, 'ingressBytes')::Int32 AS fotInBytes,
          getSubcolumn(data_json, 'egressBytes')::Int32 AS fotOutBytes,
          (getSubcolumn(data_json, 'cpuTimeMicroseconds') / 1000)::Float32 AS functionCpuTimeMs,
          if(
              isNotNull(getSubcolumn(data_json, 'wallTimeMicroseconds')),
              assumeNotNull(getSubcolumn(data_json, 'wallTimeMicroseconds')) / 1000,
              -1
          )::Float32 AS functionWallTimeMs,
          toLowCardinality(getSubcolumn(data_json, 'middlewareAction')) AS middlewareAction,
          getSubcolumn(data_json, 'middlewareActionTarget') AS middlewareActionTarget,
          getSubcolumn(data_json, 'timeToFirstByteMs')::Float32 AS ttfbMs,
          getSubcolumn(data_json, 'functionName') AS functionName,
          if(
              isNotNull(getSubcolumn(data_json, 'n1mc')),
              assumeNotNull(getSubcolumn(data_json, 'n1mc')),
              0
          )::UInt8 AS n1mc,
          if(
              isNotNull(getSubcolumn(data_json, 'concurrency')),
              assumeNotNull(getSubcolumn(data_json, 'concurrency')),
              1
          )::UInt16 AS concurrency,
          if(
              isNotNull(getSubcolumn(data_json, 'timeToHandler')),
              assumeNotNull(getSubcolumn(data_json, 'timeToHandler')),
              -1
          )::Int32 AS timeToHandler,
          if(
              isNotNull(getSubcolumn(data_json, 'isAdditionalRequest')),
              assumeNotNull(getSubcolumn(data_json, 'isAdditionalRequest')),
              0
          )::UInt8 AS isAdditionalRequest,
          if(
              isNotNull(getSubcolumn(data_json, 'maxConcurrency')),
              assumeNotNull(getSubcolumn(data_json, 'maxConcurrency')),
              1
          )::UInt16 AS maxConcurrency
      FROM Vercel_Shared.hfi_usage_facts_edge_worker_response
      WHERE timestamp >= '2025-04-16 08:00:00' AND getSubcolumn(data_json, 'invocationType') = 'middleware'

