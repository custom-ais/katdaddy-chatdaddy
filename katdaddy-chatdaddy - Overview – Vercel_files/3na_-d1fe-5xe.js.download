    ) AS maxConcurrency,
    getSubcolumn(data_json, 'billedDurationMs') AS billedDurationMs,
    getSubcolumn(data_json, 'requestDurationMs') AS requestDurationMs,
    if(isNotNull(getSubcolumn(data_json, 'maxDuration')), toInt32(assumeNotNull(getSubcolumn(data_json, 'maxDuration'))), -1) AS maxDuration,
    if(
      isNotNull(getSubcolumn(data_json, 'waitUntilDurationMs')), toInt32(assumeNotNull(getSubcolumn(data_json, 'waitUntilDurationMs'))), -1
    ) AS waitUntilDurationMs,
    getSubcolumn(data_json, 'bridgeVersion')::LowCardinality(String) AS bridgeVersion,
    if(
      isNotNull(getSubcolumn(data_json, 'totalRequests')), toUInt16(assumeNotNull(getSubcolumn(data_json, 'totalRequests'))), 1
    ) AS totalRequests,
    getSubcolumn(data_json, 'instanceId') AS instanceId,
