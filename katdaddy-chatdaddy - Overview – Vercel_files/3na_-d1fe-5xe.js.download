    getSubcolumn(data_json, 'cpuRequested')::Int64 AS cpuRequested,
    getSubcolumn(data_json, 'cpuAllocated')::Int64 AS cpuAllocated,
    getSubcolumn(data_json, 'memoryPeakBytes')::Int64 AS memoryPeakBytes,
    getSubcolumn(data_json, 'memoryUsedBytes') AS memoryUsedBytes,
    getSubcolumn(data_json, 'memoryRequested')::Int64 AS memoryRequested,
    getSubcolumn(data_json, 'memoryAllocated')::Int64 AS memoryAllocated,
    getSubcolumn(data_json, 'publicIngressBytes')::Int64 AS publicIngressBytes,
    getSubcolumn(data_json, 'publicEgressBytes')::Int64 AS publicEgressBytes,
    getSubcolumn(data_json, 'privateIngressBytes')::Int64 AS privateIngressBytes,
    getSubcolumn(data_json, 'privateEgressBytes')::Int64 AS privateEgressBytes
FROM Vercel_Shared.hfi_usage_facts_v2
WHERE
    name = 'CELL_USAGE'
    AND getSubcolumn(data_json, 'workloadType') = 'build'
