NODE endpoint
SQL >
%
{{ max_threads(Int32(threads, 2)) }}
SELECT
    * EXCEPT (
      vercel_env,
      project_id,
      owner_id,
      device_id,
      span_id,
      dynamic_path,
      hostname,
      referrer_hostname,
      device_type,
      query_params,
      path,
      event_name,
      event_data
    ),
    path AS requestPath,
    hostname AS requestHostname,
    device_id AS visitorId,
    owner_id AS ownerId,
    project_id AS projectId,
    span_id AS spanId,
    dynamic_path AS route,
    device_type AS deviceType,
    referrer_hostname AS referrerHostname,
    os_name AS osName,
    client_name AS browserName,
    vercel_env AS environment,
    event_name AS eventName,
    event_data AS eventData,
    simpleJSONExtractString(query_params, 'utm_source')   AS utmSource,
    simpleJSONExtractString(query_params, 'utm_medium')   AS utmMedium,
    simpleJSONExtractString(query_params, 'utm_campaign') AS utmCampaign,
    simpleJSONExtractString(query_params, 'utm_content')  AS utmContent,
    simpleJSONExtractString(query_params, 'utm_term')     AS utmTerm
FROM Vercel_Analytics.events_v2
WHERE
    ${I("projectIds","ownerId")}
    AND type = {{ String(type, required=True) }}
    AND timestamp >= {{ DateTime(startTime, required=True) }}
    AND timestamp < {{ DateTime(endTime, required=True) }}
