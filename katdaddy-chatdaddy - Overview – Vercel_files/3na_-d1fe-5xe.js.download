WITH
    JSONExtract(data, 'Tuple (
        ownerId String,
        projectId String,
        environment String,
        queueName String,
        region String,
        consumerGroup String,
        messageId String,
        ignoredReason String,
        emptyReason String,
        url String,
        contentType String,
        createdAt Nullable(String),
        visibilityTimeout Nullable(Int64),
        deliveryCount Nullable(Int64),
        retentionSeconds Nullable(Int64),
        duplicated Bool
    )') AS data_json
SELECT
    at AS timestamp,
    getSubcolumn(data_json, 'ownerId') AS ownerId,
    getSubcolumn(data_json, 'projectId') AS projectId,
    toLowCardinality(getSubcolumn(data_json, 'environment')) AS environment,
    getSubcolumn(data_json, 'queueName') AS queueName,
    toLowCardinality(getSubcolumn(data_json, 'region')) AS region,
    getSubcolumn(data_json, 'consumerGroup') AS consumerGroup,
    getSubcolumn(data_json, 'messageId') AS messageId,

    -- Event type from name field
    name AS eventType,

    -- QUEUE_DELETED and QUEUE_VISIBILITY_CHANGED fields
    -- toLowCardinality(getSubcolumn(data_json, 'ignoredReason')) AS ignoredReason,

    -- QUEUE_EMPTY fields
    -- toLowCardinality(getSubcolumn(data_json, 'emptyReason')) AS emptyReason,

    -- QUEUE_NOTIFIED fields
    getSubcolumn(data_json, 'url') AS notificationUrl,

    -- QUEUE_RECEIVED fields
    getSubcolumn(data_json, 'contentType') AS contentType,
    --   assumeNotNull(getSubcolumn(data_json, 'createdAt')) AS createdAt,
    if(isNotNull(getSubcolumn(data_json, 'visibilityTimeout')), assumeNotNull(getSubcolumn(data_json, 'visibilityTimeout'))::Int32, -1) AS visibilityTimeout,
    if(isNotNull(getSubcolumn(data_json, 'deliveryCount')), assumeNotNull(getSubcolumn(data_json, 'deliveryCount'))::Int32, -1) AS deliveryCount,

    if(isNotNull(getSubcolumn(data_json, 'createdAt')), age('ms', parseDateTimeBestEffort(assumeNotNull(getSubcolumn(data_json, 'createdAt'))), at), -1)::Int32 AS messageAgeMs,

    -- QUEUE_SENT fields
    if(isNotNull(getSubcolumn(data_json, 'retentionSeconds')), assumeNotNull(getSubcolumn(data_json, 'retentionSeconds')), -1)::Int32 AS retentionSeconds
    -- getSubcolumn(data_json, 'duplicated') AS duplicated

FROM Vercel_Shared.hfi_usage_facts_v2
WHERE
    name IN (
        'QUEUE_DELETED',
        'QUEUE_EMPTY',
        'QUEUE_LEASE_EXPIRED',
        'QUEUE_NOTIFIED',
        'QUEUE_RECEIVED',
        'QUEUE_SENT',
        'QUEUE_VISIBILITY_CHANGED'
    )
`,tinybirdDatasource:"queue_operation_raw_v1",tinybirdDatasourcePartitionKey:"toYYYYMMDD(timestamp)",tinybirdDatasourceSortingKey:"ownerId, eventType, toStartOfHour(timestamp), queueName",tinybirdEndpoint:"ep_queue_operation_raw_v1",tinybirdReadTokens:es,determineScopeBy:"project",dimensions:[{queryable:!1,column:"ownerId",storageType:"String"},{name:"projectId",storageType:"String"},{name:"environment",storageType:"LowCardinality(String)"},{name:"queueName",storageType:"String"},{name:"queueRegion",column:"region",storageType:"LowCardinality(String)"},{name:"consumerGroup",storageType:"String"},{name:"messageId",storageType:"String"},{name:"eventType",storageType:"LowCardinality(String)"},{name:"notificationUrl",storageType:"String"},{name:"contentType",storageType:"LowCardinality(String)"}],measures:[{name:"visibilityTimeout",storageType:"Int32"},{name:"deliveryCount",storageType:"Int32"},{name:"retentionSeconds",storageType:"Int32"},{name:"messageAgeMs",storageType:"Int32"}],retention:{days:182}}),tw=new ec({event:"buildCellUsage",tinybirdWorkspace:eo,createTinybirdDatasource:!0,tinybirdPipe:"pipe_cell_usage_build_raw_v1",tinybirdPipeQuery:`
