          vmcKind String,
          vmcByokCredentialIds String,
          vmcProviderOrder String,
          vmcProviderOnly String,
          vmcInferenceRegion String,
          routerSelector String,
          routerCandidates String,
          routerExcluded Nullable(String),
          routerPruned Nullable(String),
          routerAttempts Nullable(String),
          routerPrunedProviders Nullable(String),
          requestProviderOnly String,
          requestProviderOrder String,
          requiredCapabilities String,
          appliedPremiums String,
          appliedRuleIds String,
          sortOption String,
          byokCredentialId String,
          region String,
          teamSlug String,
          teamName String,
          teamPlanType String,
          billingStatus String,
          serviceTier String,
          vercelId String,
          sessionId String,
          ipAddress String,
          geoCountry String,
          geoCountryRegion String,
          geoCity String,
          contentCaptureStatus String,
          contentCaptureInputs Nullable(String),
          contentCaptureOutputs Nullable(String),
          transcriptStatus String,
          transcriptInputs Nullable(String),
          transcriptOutputs Nullable(String),
          inferenceEndpointSlug String,
          inferenceScope String,
          inferenceGeoRegion String,
          inferenceProviderRegion String,
          requestedInferenceRegion String,
          cost Nullable(String),
          amount String,
          marketCost Nullable(String),
          inputCostPerToken Nullable(String),
          inputListCostPerToken Nullable(String),
          inputTokens Int64,
          outputCostPerToken Nullable(String),
          outputListCostPerToken Nullable(String),
          outputTokens Int64,
          cachedInputTokens Int64,
          cachedInputListTokensCost Nullable(String),
          cacheCreationInputTokens Int64,
          cacheCreationInputListTokensCost Nullable(String),
          cacheCreation1hInputTokens Nullable(Int64),
          cacheCreation1hInputTokensCost Nullable(String),
          reasoningTokens Int64,
