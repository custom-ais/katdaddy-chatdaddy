          timeToFirstTokenMs Int64,
          timeToFirstReasoningTokenMs Nullable(Int64),
          timeToFirstTextTokenMs Nullable(Int64),
          timeToFirstToolCallTokenMs Nullable(Int64),
          tokenThroughput Int64,
          responseStatusCode Int64,
          internalResponseStatusCode Nullable(Int64),
          rerankingQueryCount Nullable(Int64),
          imageCount Nullable(Int64),
          videoCount Nullable(Int64),
          videoDurationSeconds Nullable(Float64),
          transcriptionInputDurationSeconds Nullable(Float64),
          realtimeSessionDurationSeconds Nullable(Float64),
          videoResolution String,
          videoAspectRatio String,
          videoFps Nullable(Int64),
          realtimeClientMessageCount Nullable(Int64),
          zdrCost Nullable(String),
