NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}
SELECT
    timestamp,
    project_id as projectId,
    deployment_id as deploymentId,
    environment,
    route,
    cache as cacheResult,
    arrayJoin(cache_tags) as cacheTags
FROM proxy_response_raw
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND path_type_variant = 'imgopt'
  AND cache_tags != []
  AND ${I("projectIds","ownerId")}
