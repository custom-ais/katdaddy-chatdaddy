    getSubcolumn(data_json, 'privateIngressBytes')::Int64 AS privateIngressBytes,
    getSubcolumn(data_json, 'privateEgressBytes')::Int64 AS privateEgressBytes,

    -- Point-in-time memory gauge (bytes)
    ifNull(getSubcolumn(data_json, 'memoryUsedBytes'), -1)::Int64 AS memoryUsedBytes`,tq=new ec({event:(t={event:"sandboxUsage",name:"sandbox",metadataSelect:`    ${tC("ownerId")} AS ownerId,
