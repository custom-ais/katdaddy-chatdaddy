          addedCreditCard Nullable(Bool),
          isFreeTier Nullable(Bool),
          isByok Nullable(Bool),
          isPrivateModel Nullable(Bool),
          isStreaming Nullable(Bool),
          isRequestZdr Nullable(Bool),
          hipaaRequested Nullable(Bool),
          quotaRequested Nullable(Bool),
          evaluationFallbackConfigured Nullable(Bool),
          evaluationFallbackTriggered Nullable(Bool),
