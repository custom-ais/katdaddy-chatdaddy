    -- CPU time deltas (milliseconds; CPU-ms is core-time)
    getSubcolumn(data_json, 'cpuTotalTimeMs')::Int64 AS cpuTotalTimeMs,
    if(${tR} > 0, (getSubcolumn(data_json, 'cpuTotalTimeMs')::Float64 / ${tR}::Float64) * 100, 0)::Float64 AS cpuUsage,
    getSubcolumn(data_json, 'cpuVMTimeMs')::Int64 AS cpuVMTimeMs,
    getSubcolumn(data_json, 'cpuNetworkProxyTimeMs')::Int64 AS cpuNetworkProxyTimeMs,
    getSubcolumn(data_json, 'cpuManagerTimeMs')::Int64 AS cpuManagerTimeMs,

    -- vCPU counts normalized to core-time over the period (vCPU x periodDurationMs)
    ${tR} AS cpuRequestedTimeMs,
    (getSubcolumn(data_json, 'cpuAllocated') * ${tA})::Int64 AS cpuAllocatedTimeMs,

