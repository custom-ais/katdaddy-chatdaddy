            isrShieldRegion LowCardinality(String),
            vercelCache LowCardinality(String),
            cacheHitState LowCardinality(String),
            cacheHitLevel LowCardinality(String),
            publicIp String,
            publicIpCountry String,
            httpUserAgent String,
            ja4Digest String,
            asnName String,
            asnId String,
            skewDeploymentId String,
            wafAction String,
            wafRuleId String,
            blobStoreId String,
            skewDeploymentSkipReason String,
            contentType String,
            botName String,
            botCategory String,
            botVerified String,
            externalRewriteTargetHost String,
            externalRewriteTargetPath String,
            resolvedDynamicPath String,
            ingressBytes String,
            egressBytes String,
            routeCpuDurationMs String,
            isrShieldReadBytes String,
            isrShieldWriteBytes String,
            vdcReadUnits String,
            vdcWriteUnits String,
            blobEgressBytes String,
            externalRewriteConnectMs String,
            externalRewriteDnsMs String,
            microfrontendsResponseReason LowCardinality(String),
            microfrontendsMatchedPath String,
            microfrontendsDefaultAppDeploymentId String,
            microfrontendsDefaultAppProjectId String,
            service String,
            signatureAgent String,
            httpAccept String,
            cacheTags String,
            cacheReason String,
            pprState String,
            triggeringTag String,
            isPrefetchRequest Bool
            )'
        ) AS data_json,
        getSubcolumn(data_json, 'targetPath') as raw_source_path,
        getSubcolumn(data_json, 'requestPath') as raw_request_path,
        cutQueryString(raw_request_path) as cut_request_path,
        if(
            startsWith(raw_source_path, '/'), raw_source_path, concat('/', raw_source_path)
        ) as source_path,
        if(
            startsWith(cut_request_path, '/'), cut_request_path, concat('/', cut_request_path)
        ) as request_path,
        if(
            path_type == 'external',
            request_path,
            replaceRegexpOne(source_path, '/_next/data/([^/]+)/', '/_next/data/[buildId]/')
        ) as source_path_normalized
    SELECT
        at as timestamp,
        getSubcolumn(data_json, 'projectId') as project_id,
        getSubcolumn(data_json, 'ownerId') as owner_id,
        getSubcolumn(data_json, 'deploymentId') as deployment_id,
        splitByString('::', getSubcolumn(data_json, 'vercelId'))[-1] AS request_id,
        getSubcolumn(data_json, 'deploymentEnvironment')::LowCardinality(String) as environment,
        getSubcolumn(data_json, 'locationRedacted') as location_redacted,
        getSubcolumn(data_json, 'redirectLocation') as redirect_location,
        getSubcolumn(data_json, 'pathType')::LowCardinality(String) as path_type,
        getSubcolumn(data_json, 'pathTypeVariant')::LowCardinality(String) as path_type_variant,
        replaceRegexpAll(source_path_normalized, '(\\.rsc|\\.prefetch)$', '') as route,
        getSubcolumn(data_json, 'serverAction') as server_action,
        getSubcolumn(data_json, 'requestMethod')::LowCardinality(String) as request_method,
        getSubcolumn(data_json, 'requestHost') as request_hostname,
        request_path,
        extractKeyValuePairs(
            left(queryString(decodeURLComponent(getSubcolumn(data_json, 'requestPath'))), 256), '=', '&'
        ) as request_search_params,
        getSubcolumn(data_json, 'httpReferer') as referrer_url,
        domain(referrer_url) as referrer_hostname,
        getSubcolumn(data_json, 'responseStatus')::Int16 as http_status,
        getSubcolumn(data_json, 'errorDetails')::LowCardinality(String) as error_code,
        getSubcolumn(data_json, 'vercelRegion')::LowCardinality(String) as edge_region,
        getSubcolumn(data_json, 'isrShieldRegion')::LowCardinality(String) as isr_shield_region,
        getSubcolumn(data_json, 'vercelCache')::LowCardinality(String) as cache,
        getSubcolumn(data_json, 'cacheHitState')::LowCardinality(String) as hit_state,
        getSubcolumn(data_json, 'cacheHitLevel')::LowCardinality(String) as hit_level,
        getSubcolumn(data_json, 'publicIp') as client_ip,
        getSubcolumn(data_json, 'publicIpCountry') as client_ip_country,
        getSubcolumn(data_json, 'httpUserAgent') as client_user_agent,
        getSubcolumn(data_json, 'ja4Digest') as ja4_digest,
        getSubcolumn(data_json, 'asnName') as asn,
        getSubcolumn(data_json, 'asnId') as asn_id,
        if(getSubcolumn(data_json, 'skewDeploymentId') != '', 'active', 'inactive') as skew_protection,
        if(
            getSubcolumn(data_json, 'wafAction') != '', getSubcolumn(data_json, 'wafAction'), 'allow'
        ) as waf_action,
        getSubcolumn(data_json, 'wafRuleId') as waf_rule_id,
        getSubcolumn(data_json, 'blobStoreId') as store_id,
        getSubcolumn(data_json, 'skewDeploymentSkipReason') as skew_deployment_skip_reason,
        getSubcolumn(data_json, 'contentType') as content_type,
        getSubcolumn(data_json, 'botName') as bot_name,
        getSubcolumn(data_json, 'botCategory') as bot_category,
        getSubcolumn(data_json, 'botVerified') as bot_verified,
        getSubcolumn(data_json, 'signatureAgent') as signature_agent,
        getSubcolumn(data_json, 'httpAccept') as http_accept,
        getSubcolumn(data_json, 'cacheReason') as cache_reason,
        getSubcolumn(data_json, 'pprState') as ppr_state,
        getSubcolumn(data_json, 'triggeringTag') as triggering_tag,
        getSubcolumn(data_json, 'externalRewriteTargetHost') as external_rewrite_target_host,
        getSubcolumn(data_json, 'externalRewriteTargetPath') as external_rewrite_target_path,
        getSubcolumn(data_json, 'resolvedDynamicPath') as resolved_dynamic_path,
        getSubcolumn(data_json, 'microfrontendsResponseReason') as microfrontends_response_reason,
        getSubcolumn(data_json, 'microfrontendsMatchedPath') as microfrontends_matched_path,
        getSubcolumn(data_json, 'microfrontendsDefaultAppDeploymentId') as microfrontends_default_app_deployment_id,
        getSubcolumn(data_json, 'microfrontendsDefaultAppProjectId') as microfrontends_default_app_project_id,
        getSubcolumn(data_json, 'service') as service,
        if(getSubcolumn(data_json, 'isPrefetchRequest'), 'true', 'false')::LowCardinality(String) as is_prefetch_request,
        if(
            getSubcolumn(data_json, 'cacheTags') != '',
            splitByChar(',', getSubcolumn(data_json, 'cacheTags')),
            []
        ) as cache_tags,
        -- Measures
        if(
            (getSubcolumn(data_json, 'ingressBytes') != '')
            AND error_code NOT IN ('DEPLOYMENT_BLOCKED', 'DEPLOYMENT_PAUSED')
            AND path_type != 'background_func',
            toInt32OrDefault(getSubcolumn(data_json, 'ingressBytes'), -1::Int32),
            -1::Int32
        )::Int32 as fdt_in_bytes,
        if(
            (getSubcolumn(data_json, 'egressBytes') != '')
            AND (error_code NOT IN ('DEPLOYMENT_BLOCKED', 'DEPLOYMENT_PAUSED'))
            AND (path_type != 'background_func'),
            toInt32OrDefault(getSubcolumn(data_json, 'egressBytes'), -1::Int32),
            -1::Int32
        )::Int32 as fdt_out_bytes,
        toFloat32OrDefault(getSubcolumn(data_json, 'routeCpuDurationMs'), -1::Float32) as duration_ms,
        toInt32OrDefault(
            getSubcolumn(data_json, 'isrShieldReadBytes'), -1::Int32
        ) as isr_shield_read_bytes,
        toInt32OrDefault(
            getSubcolumn(data_json, 'isrShieldWriteBytes'), -1::Int32
        ) as isr_shield_write_bytes,
        toInt32OrDefault(getSubcolumn(data_json, 'vdcReadUnits'), -1::Int32) as vdc_read_units,
        toInt32OrDefault(getSubcolumn(data_json, 'vdcWriteUnits'), -1::Int32) as vdc_write_units,
        toInt64OrDefault(getSubcolumn(data_json, 'blobEgressBytes'), -1::Int64) as bdt_out_bytes,
        toFloat32OrDefault(
            getSubcolumn(data_json, 'externalRewriteConnectMs'), -1::Float32
        ) as external_rewrite_connect_ms,
        toFloat32OrDefault(
            getSubcolumn(data_json, 'externalRewriteDnsMs'), -1::Float32
        ) as external_rewrite_dns_ms
    FROM Vercel_Shared.hfi_usage_facts_proxy_response
    WHERE name = 'PROXY_RESPONSE'

TYPE MATERIALIZED
DATASOURCE ${this.tinybirdMaterialization}`,t=`
VERSION ${this.tinybirdMaterializationVersion}

${this.tinybirdReadTokens.map(e=>`TOKEN ${e} READ`).join("\n")}

SCHEMA >
    -- Dimensions
    timestamp DateTime('UTC'),
    owner_id String DEFAULT '',
    project_id String,
    deployment_id String,
    request_id String,
    environment LowCardinality(String),
    location_redacted String,
    path_type LowCardinality(String),
    path_type_variant LowCardinality(String),
    route String,
    server_action String,
    request_method LowCardinality(String),
    request_hostname String,
    request_path String,
    request_search_params Map(String, String),
    referrer_url String,
    referrer_hostname String,
    http_status Int16,
    error_code LowCardinality(String),
    client_ip String,
    client_ip_country LowCardinality(String),
    client_user_agent String,
    ja4_digest String DEFAULT '',
    asn String,
    asn_id String,
    cache LowCardinality(String),
    hit_state LowCardinality(String),
    hit_level LowCardinality(String),
    edge_region LowCardinality(String),
    isr_shield_region LowCardinality(String) DEFAULT '',
    skew_protection LowCardinality(String) DEFAULT '',
    waf_action LowCardinality(String) DEFAULT '',
    waf_rule_id String DEFAULT '',
    store_id String DEFAULT '',
    skew_deployment_skip_reason LowCardinality(String) DEFAULT '',
    content_type LowCardinality(String) DEFAULT '',
    bot_name LowCardinality(String) DEFAULT '',
    bot_category LowCardinality(String) DEFAULT '',
    bot_verified LowCardinality(String) DEFAULT '',
    signature_agent String DEFAULT '',
    http_accept String DEFAULT '',
    cache_reason LowCardinality(String) DEFAULT '',
    ppr_state LowCardinality(String) DEFAULT '',
    triggering_tag String DEFAULT '',
    external_rewrite_target_host String DEFAULT '',
    external_rewrite_target_path String DEFAULT '',
    resolved_dynamic_path String DEFAULT '',
    redirect_location String DEFAULT '',
    microfrontends_response_reason LowCardinality(String) DEFAULT '',
    microfrontends_matched_path String DEFAULT '',
    microfrontends_default_app_deployment_id String DEFAULT '',
    microfrontends_default_app_project_id String DEFAULT '',
    service String DEFAULT '',
    is_prefetch_request LowCardinality(String) DEFAULT '',
    cache_tags Array(String) DEFAULT [],
    -- Measures
    fdt_in_bytes Int32,
    fdt_out_bytes Int32,
    isr_shield_read_bytes Int32 DEFAULT -1,
    isr_shield_write_bytes Int32 DEFAULT -1,
    vdc_read_units Int32 DEFAULT -1,
    vdc_write_units Int32 DEFAULT -1,
    bdt_out_bytes Int64 DEFAULT -1, -- Blob Data Transfer Out Bytes
    duration_ms Float32,
    external_rewrite_connect_ms Float32 DEFAULT -1,
    external_rewrite_dns_ms Float32 DEFAULT -1

ENGINE "MergeTree"
ENGINE_PARTITION_KEY "toYYYYMMDD(timestamp)"
ENGINE_SORTING_KEY project_id, toStartOfHour(timestamp), environment, path_type, route
ENGINE_TTL toDateTime(timestamp) + ${(0,c.W)(this.retention)}${this.sharedWith&&this.sharedWith.length>0?`
SHARED_WITH >
    ${this.sharedWith.join("\n    ")}`:""}
`,n=e=>{let{cacheTagsExpression:t,tagsOnlyFilter:n}=e;return`
${this.tinybirdReadTokens.map(e=>`TOKEN ${e} READ`).join("\n")}

NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}
SELECT
    timestamp,
    project_id,
    deployment_id,
    request_id,
    environment,
    location_redacted as locationRedacted,
    redirect_location as redirectLocation,
    path_type,
    route,
    server_action,
    request_method,
    request_hostname,
    request_path,
    request_search_params,
    referrer_url,
    referrer_hostname,
    http_status,
    error_code,
    client_ip,
    client_ip_country,
    client_user_agent,
    asn,
    asn_id,
    cache,
    hit_state,
    hit_level,
    edge_region,
    fdt_in_bytes as request_bytes,
    -1 as response_bytes,
    fdt_out_bytes as response_body_bytes,
    if(path_type = 'background_func', -1, fdt_in_bytes) as fdt_in_bytes, -- FDT was miscounted for background func before this date. Can be removed after Nov 14th, 2024
    if(path_type = 'background_func', -1, fdt_out_bytes) as fdt_out_bytes,
    duration_ms,
    project_id as projectId,
    deployment_id as deploymentId,
    request_id as requestId,
    path_type as pathType,
    path_type_variant as pathTypeVariant,
    request_method as requestMethod,
    request_hostname as requestHostname,
    request_path as requestPath,
    referrer_url as referrerUrl,
    referrer_hostname as referrerHostname,
    http_status as httpStatus,
    error_code as errorCode,
    client_ip as clientIp,
    client_ip_country as clientIpCountry,
    client_user_agent as clientUserAgent,
    ja4_digest as clientJa4Digest,
    bot_name as botName,
    if(bot_verified = 'skip', '', bot_verified) as botVerified,
    bot_category as botCategory,
    signature_agent as signatureAgent,
    http_accept as httpAccept,
    content_type as contentType,
    triggering_tag as triggeringTag,
    ${t} as cacheTags,
    cache_reason as cacheReason,
    ppr_state as pprState,
    asn as asnName,
    asn_id as asnId,
    cache as cacheResult,
    hit_state as cacheHitState,
    hit_level as cacheHitLevel,
    edge_region as edgeNetworkRegion,
    isr_shield_region as isrShieldRegion, -- Deprecated, prefer isrCacheRegion
    isr_shield_region as isrCacheRegion,
    skew_protection as skewProtection,
    if(waf_action = '', 'allow', waf_action) as wafAction,
    if(waf_rule_id = 'managed_bot_filter', 'managed_bot_protection', waf_rule_id) as wafRuleId,
    fdt_in_bytes as fdtInBytes,
    fdt_out_bytes as fdtOutBytes,
    external_rewrite_connect_ms as externalRewriteConnectMs,
    external_rewrite_dns_ms as externalRewriteDnsMs,
    external_rewrite_target_host as rewriteDestinationHostname, -- Deprecated, prefer externalRewriteTargetHost
    external_rewrite_target_host as externalRewriteTargetHost,
    external_rewrite_target_path as externalRewriteTargetPath,
    resolved_dynamic_path as resolvedDynamicPath,
    microfrontends_response_reason as microfrontendsResponseReason,
    microfrontends_matched_path as microfrontendsMatchedPath,
    microfrontends_default_app_deployment_id as microfrontendsDefaultAppDeploymentId,
    microfrontends_default_app_project_id as microfrontendsDefaultAppProjectId,
    service,
    is_prefetch_request as isPrefetchRequest,
    -- Legacy bandwidth
    fdtInBytes as requestBytes,
    fdtOutBytes as responseBodyBytes,
    isr_shield_read_bytes as isrShieldReadBytes,
    isr_shield_write_bytes as isrShieldWriteBytes,
    vdc_read_units as vdcReadUnits, -- Deprecated, prefer isrReadUnits
    vdc_read_units as isrReadUnits,
    vdc_write_units as vdcWriteUnits, -- Deprecated, prefer isrWriteUnits
    vdc_write_units as isrWriteUnits,
    bot_category_legacy as botCategoryLegacy, -- Deprecated, temporary
    duration_ms as requestDurationMs,
    server_action as serverActionName
FROM ${this.tinybirdMaterialization}
LEFT ANY JOIN (
  select user_agent as bot_user_agent, categories[1] as bot_category_legacy
  from known_bots
)
on bot_user_agent = client_user_agent
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND ${I("projectIds","ownerId")}
  AND owner_id = {{ String(ownerId, required=True) }}
  AND path_type != 'background_func'${n}
`},a=n({cacheTagsExpression:"cache_tags",tagsOnlyFilter:""}),i=n({cacheTagsExpression:"arrayJoin(cache_tags)",tagsOnlyFilter:"\n  AND cache_tags != []"});return[{filename:`pipes/${this.tinybirdPipePrefix}.pipe`,contents:e},{filename:`datasources/${this.tinybirdMaterialization}.datasource`,contents:t},{filename:`endpoints/${this.tinybirdEndpoint}.pipe`,contents:a},{filename:`endpoints/${this.tagsEndpoint}.pipe`,contents:i}]}},et=new Set(["timestamp","projectId","deploymentId","environment","pathType","route","cacheResult","cacheHitState","cacheHitLevel","isrShieldRegion","isrCacheRegion","isrShieldReadBytes","isrReadBytes","isrShieldWriteBytes","isrWriteBytes","isrReadUnits","isrWriteUnits","cacheTags"]),en=class{constructor(e){this.tinybirdWorkspace=e.tinybirdWorkspace,this.tinybirdDatasource=e.tinybirdDatasource,this.tinybirdEndpoint=e.tinybirdEndpoint,this.tinybirdReadTokens=e.tinybirdReadTokens,this.event=e.event,this.retention=e.retention}get tagsEndpoint(){return`${this.tinybirdEndpoint}_tags`}isTagsQuery(e){return e.groupBy?.includes("cacheTags")??!1}canServe(e){return e.event===this.event}buildQuery(e){this.isTagsQuery(e)&&B("isrOperation",e,et);let t=V(e),n=this.isTagsQuery(e)?this.tagsEndpoint:this.tinybirdEndpoint;return{tinybirdWorkspace:this.tinybirdWorkspace,tinybirdEndpoint:n,sql:t,params:O(e)}}buildSchemas(){let e="path_type in ('prerender', 'partial_prerender', 'background_func') and (path_type_variant != 'imgopt_shield_write')",t=this.tinybirdReadTokens.map(e=>`TOKEN ${e} READ`).join("\n"),n=`
${t}
NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}
SELECT
    timestamp,
    project_id as projectId,
    deployment_id as deploymentId,
    request_id as requestId,
    environment,
    path_type as pathType,
    route,
    request_method as requestMethod,
    request_hostname as requestHostname,
    request_path as requestPath,
    referrer_url as referrerUrl,
    referrer_hostname as referrerHostname,
    http_status as httpStatus,
    error_code as errorCode,
    client_ip as clientIp,
    client_ip_country as clientIpCountry,
    client_user_agent as clientUserAgent,
    ja4_digest as clientJa4Digest,
    asn as asnName,
    asn_id as asnId,
    cache as cacheResult,
    hit_state as cacheHitState,
    hit_level as cacheHitLevel,
    edge_region as edgeNetworkRegion,
    isr_shield_region as isrShieldRegion, -- Deprecated, prefer isrCacheRegion
    isr_shield_region as isrCacheRegion,
    skew_protection as skewProtection,
    isr_shield_read_bytes as isrShieldReadBytes, -- Deprecated, prefer isrReadBytes
    isr_shield_read_bytes as isrReadBytes,
    isr_shield_write_bytes as isrShieldWriteBytes, -- Deprecated, prefer isrWriteBytes
    isr_shield_write_bytes as isrWriteBytes,
    vdc_read_units as vdcReadUnits, -- Deprecated, prefer isrReadUnits
    vdc_read_units as isrReadUnits,
    vdc_write_units as vdcWriteUnits, -- Deprecated, prefer isrWriteUnits
    vdc_write_units as isrWriteUnits
FROM ${this.tinybirdDatasource}
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  -- Only use path_types which are relevant to ISR for performance
  AND ${e}
  AND ${I("projectIds","ownerId")}
`,a=`
${t}
NODE endpoint
SQL >
    %
{{ max_threads(Int32(threads, 16)) }}
SELECT
    timestamp,
    project_id as projectId,
    deployment_id as deploymentId,
    environment,
    path_type as pathType,
    route,
    cache as cacheResult,
    hit_state as cacheHitState,
    hit_level as cacheHitLevel,
    isr_shield_region as isrShieldRegion,
    isr_shield_region as isrCacheRegion,
    isr_shield_read_bytes as isrShieldReadBytes,
    isr_shield_read_bytes as isrReadBytes,
    isr_shield_write_bytes as isrShieldWriteBytes,
    isr_shield_write_bytes as isrWriteBytes,
    vdc_read_units as isrReadUnits,
    vdc_write_units as isrWriteUnits,
    arrayJoin(cache_tags) as cacheTags
FROM ${this.tinybirdDatasource}
WHERE timestamp >= {{ DateTime(startTime, required=True) }} AND timestamp < {{ DateTime(endTime, required=True) }}
  AND ${e}
  AND cache_tags != []
  AND ${I("projectIds","ownerId")}
`;return[{filename:`endpoints/${this.tinybirdEndpoint}.pipe`,contents:n},{filename:`endpoints/${this.tagsEndpoint}.pipe`,contents:a}]}},ea=class{constructor(e){this.tinybirdWorkspace=e.tinybirdWorkspace,this.tinybirdMaterialization=e.tinybirdMaterialization,this.tinybirdMaterializationVersion=e.tinybirdMaterializationVersion,this.tinybirdEndpoint=e.tinybirdEndpoint,this.tinybirdReadTokens=e.tinybirdReadTokens,this.event=e.event,this.retention=e.retention}canServe(e){return e.event===this.event}buildQuery(e){let t=V(e);return{tinybirdWorkspace:this.tinybirdWorkspace,tinybirdEndpoint:this.tinybirdEndpoint,sql:t,params:O(e)}}eventCountPerDayQuery(){return`
        WITH
          1 + if(toLastDayOfMonth(day) < today(), toLastDayOfMonth(day), today()) - if(toStartOfMonth(day) > toDate(min(timestamp)), toStartOfMonth(day), toDate(min(timestamp))) as daysInMonth
        SELECT '${this.event}' as event, YYYYMMDDToDate(1 + toYYYYMM(timestamp) * 100) as day, (count() / daysInMonth) :: UInt64 as eventCount
        FROM ${this.tinybirdMaterialization}
        GROUP BY ALL
        HAVING day >= toDate(min(timestamp))
        ORDER BY day ASC WITH FILL TO today() INTERPOLATE (event, eventCount)
    `}eventUsage(e){return`
        SELECT
          ownerId,
          project_id as projectId,
          toStartOfInterval(timestamp, ${e}) as timestamp,
          '${this.event}' as eventType,
          count() as count
        FROM ${this.tinybirdMaterialization}
        ANY LEFT JOIN (SELECT * FROM Vercel_Shared.projects_by_project_id__v1 FINAL) USING projectId
        WHERE {% if defined(time_bucket) %}
          timestamp = toStartOfFifteenMinutes(parseDateTimeBestEffort({{ String(time_bucket) }}))
        {% else %}
          timestamp = toStartOfFifteenMinutes(now() - ${e})
        {% end %}
        GROUP BY ALL
    `}buildSchemas(){let e=`
VERSION 1

DESCRIPTION >
    Materialization pipe for outgoing fetch requests from hfi_usage_facts_function_fetch_request.

NODE from_json
SQL >
    WITH
        JSONExtract(data, 'Tuple (
            start String,
            projectId String,
            ownerId String,
            source String,
            edgeType String,
            duration Int64,
            dnsDuration Int64,
            cacheDuration Int64,
            netDuration Int64,
            tlsDuration Int64,
            statusCode Int64,
            method String,
            host String,
            path String,
            search String,
            resolvedIp String,
            fetchType String,
            fetchIdx Int64,
            fetchHost String,
            fetchPath String,
            pathType String,
            requestId String,
            requestApi String,
            lambdaRegion String,
            deploymentId String,
            invocationHost String,
            invocationPath String,
            invocationRoute String,
            unresolved Int64,
            reason String,
            environment String,
            bodyDuration Int64,
            requestTransferBytes Int64,
            responseTransferBytes Int64
        )') AS data_json
    SELECT
        at as timestamp,
        getSubcolumn(data_json, 'start') as real_timestamp,
        getSubcolumn(data_json, 'projectId') as project_id,
        getSubcolumn(data_json, 'ownerId') as owner_id,
        getSubcolumn(data_json, 'source') as source,
        getSubcolumn(data_json, 'edgeType') as edge_type,
        getSubcolumn(data_json, 'duration') as duration,
        getSubcolumn(data_json, 'dnsDuration') as dns_duration,
        getSubcolumn(data_json, 'cacheDuration') as cache_duration,
        getSubcolumn(data_json, 'netDuration') as net_duration,
        getSubcolumn(data_json, 'tlsDuration') as tls_duration,
        getSubcolumn(data_json, 'statusCode') as http_status,
        getSubcolumn(data_json, 'method') as request_method,
        getSubcolumn(data_json, 'host') as request_hostname,
        getSubcolumn(data_json, 'path') as request_path,
        getSubcolumn(data_json, 'search') as request_search_params,
        getSubcolumn(data_json, 'resolvedIp') as request_resolved_ip,
        getSubcolumn(data_json, 'fetchType') as fetch_type,
        getSubcolumn(data_json, 'fetchIdx') as fetch_idx,
        getSubcolumn(data_json, 'fetchHost') as fetch_hostname,
        getSubcolumn(data_json, 'fetchPath') as fetch_path,
        getSubcolumn(data_json, 'pathType') as path_type,
        getSubcolumn(data_json, 'requestId') as request_id,
        getSubcolumn(data_json, 'requestApi') as request_api,
        getSubcolumn(data_json, 'lambdaRegion') as lambda_region,
        getSubcolumn(data_json, 'deploymentId') as deployment_id,
        getSubcolumn(data_json, 'invocationHost') as invocation_host,
        getSubcolumn(data_json, 'invocationPath') as invocation_path,
        getSubcolumn(data_json, 'invocationRoute') as invocation_route,
        getSubcolumn(data_json, 'unresolved') as unresolved,
        getSubcolumn(data_json, 'reason') as reason,
        getSubcolumn(data_json, 'environment') as environment,
        getSubcolumn(data_json, 'bodyDuration') as body_duration,
        getSubcolumn(data_json, 'requestTransferBytes') as request_transfer_bytes,
        getSubcolumn(data_json, 'responseTransferBytes') as response_transfer_bytes
    FROM Vercel_Shared.hfi_usage_facts_function_fetch_request
    WHERE request_hostname != 'localhost' AND request_path != '/v1/traces'

NODE mv_fetch_requests
SQL >
    WITH
        length(real_timestamp) > 10 as has_real_timestamp,
        multiIf(
            from_json.fetch_type = 'fetch-get',
            'cache-get',
            from_json.fetch_type = 'fetch-set',
            'cache-set',
            empty(from_json.fetch_type),
            'origin',
            from_json.fetch_type
        ) as normalised_fetch_type,
        if(
            normalised_fetch_type != 'origin' and notEmpty(from_json.fetch_hostname),
            from_json.fetch_path,
            from_json.request_path
        ) as real_request_path
    select
        coalesce(
            if(has_real_timestamp, parseDateTime64BestEffortOrNull(real_timestamp), null),
            toDateTime64(timestamp - interval duration ms, 3)
        ) as timestamp,
        project_id,
        owner_id,
        toLowCardinality(source) as source,
        toLowCardinality(edge_type) as edge_type,
        toUInt16(duration) duration_ms,
        toUInt16(dns_duration) dns_duration_ms,
        toUInt16(cache_duration) cache_duration_ms,
        toUInt16(net_duration) net_duration_ms,
        toUInt16(tls_duration) tls_duration_ms,
        toInt16(http_status) as http_status,
        toLowCardinality(upper(request_method)) as request_method,
        if(
            normalised_fetch_type != 'origin' and notEmpty(from_json.fetch_hostname),
            from_json.fetch_hostname,
            from_json.request_hostname
