    `},{name:"mv_edge_worker_response_v3",query:`
WITH
    JSONExtract(data, 'Tuple (
        clientRequestPath String,
        sourceName String,
        projectId String,
        ownerId String,
        deploymentId String,
        deploymentPlan String,
        vercelId String,
        environment String,
        middlewareAction String,
        middlewareActionTarget String,
        clientRequestHost Nullable(String),
        clientRequestMethod Nullable(String),
        clientRequestReferer String,
        responseStatus Nullable(Int64),
        clientRequestUserAgent String,
        invocationType String,
        vercelRegion String,
        computeRegion String,
        startType String,
        ingressBytes Nullable(Int64),
        egressBytes Nullable(Int64),
        wallTimeMicroseconds Nullable(Float64),
        timeToFirstByteMs Nullable(Int64),
        cpuTimeMicroseconds Nullable(Int64),
        newCpuTime Nullable(Int64),
        functionName Nullable(String),
        n1mc Nullable(Bool),
        timeToHandler Nullable(Int64),
        isAdditionalRequest Nullable(Bool),
        concurrency Nullable(UInt64),
        maxConcurrency Nullable(UInt64),
        bridgeVersion String,
        totalRequests Nullable(UInt64),
        invocationId String,
        instanceId String,
        coldStartDurationMs Nullable(Int64),
        lambdaRequestId String
    )') AS data_json,
    -- Existing logic to extract path components if needed
    extractAllGroups(getSubcolumn(data_json, 'clientRequestPath'), '^/([^/]+)/([^/]+)/([^/]+)/([^/]+)(/.*)?$') AS clientRequestPathGroups,
    -- Existing logic to calculate route
    getSubcolumn(data_json, 'sourceName') as sourcePath,
    if(startsWith(sourcePath,'/'), sourcePath, concat('/', sourcePath)) as normalizedSourcePath,
    replaceRegexpOne(normalizedSourcePath, '/_next/data/([^/]+)/', '/_next/data/[buildId]/') as source_norm,
    replaceRegexpAll(source_norm, '(\\.rsc|\\.prefetch)$', '') as route
SELECT
    -- Core Identifiers & Context
    at AS timestamp,
    getSubcolumn(data_json, 'projectId') AS projectId,
    getSubcolumn(data_json, 'ownerId') AS ownerId,
    getSubcolumn(data_json, 'deploymentId') AS deploymentId,
    toLowCardinality(getSubcolumn(data_json, 'deploymentPlan')) AS deploymentPlan,
    splitByString('::', getSubcolumn(data_json, 'vercelId'))[-1] AS requestId, -- Use vercelId
    toLowCardinality(getSubcolumn(data_json, 'environment')) AS environment,

    -- Middleware Specifics
    toLowCardinality(getSubcolumn(data_json, 'middlewareAction')) AS middlewareAction,
    getSubcolumn(data_json, 'middlewareActionTarget') AS middlewareActionTarget,

    -- Request Details
    if(
        isNotNull(getSubcolumn(data_json, 'clientRequestHost')),
        assumeNotNull(getSubcolumn(data_json, 'clientRequestHost')),
        if(
            length(clientRequestPathGroups) > 0,
            clientRequestPathGroups[1][4],
            ''
        )
    ) AS requestHost,
    if(
        length(clientRequestPathGroups) > 0,
        coalesce(clientRequestPathGroups[1][5], getSubcolumn(data_json, 'clientRequestPath')),
        getSubcolumn(data_json, 'clientRequestPath')
    ) AS requestPath,
    toLowCardinality(
        if(
            isNotNull(getSubcolumn(data_json, 'clientRequestMethod')),
            assumeNotNull(getSubcolumn(data_json, 'clientRequestMethod')),
            if(
                length(clientRequestPathGroups) > 0,
                clientRequestPathGroups[1][2],
                'GET' -- Default to GET if no method found
            )
        )
    ) AS requestMethod,
    route,
    getSubcolumn(data_json, 'clientRequestReferer') AS referer,
    domain(referer) AS referrerHostname,
    if(isNotNull(getSubcolumn(data_json, 'responseStatus')), assumeNotNull(getSubcolumn(data_json, 'responseStatus')), 200)::Int16 AS statusCode,

    -- Client Details
    '' AS publicIp,
    getSubcolumn(data_json, 'clientRequestUserAgent') AS userAgent,

    -- Execution Location & Type
    if(isNotNull(getSubcolumn(data_json, 'functionName')), 'lambda', 'cf') as provider,
    if(getSubcolumn(data_json, 'invocationType') = 'middleware', 'middleware', 'function') as cause,
    'edge' AS runtime,
    toLowCardinality(getSubcolumn(data_json, 'vercelRegion')) AS vercelRegion,
    toLowCardinality(getSubcolumn(data_json, 'computeRegion')) AS lambdaRegion,
    toLowCardinality(getSubcolumn(data_json, 'startType')) AS startType,

    -- Performance & Resource Measures
    if(isNotNull(getSubcolumn(data_json, 'ingressBytes')), assumeNotNull(getSubcolumn(data_json, 'ingressBytes')), 0)::Int64 AS ingressBytes,
    if(isNotNull(getSubcolumn(data_json, 'egressBytes')), assumeNotNull(getSubcolumn(data_json, 'egressBytes')), 0)::Int64 AS egressBytes,
    if(isNotNull(getSubcolumn(data_json, 'wallTimeMicroseconds')), assumeNotNull(getSubcolumn(data_json, 'wallTimeMicroseconds')) / 1000.0, 0.0)::Int32 AS requestDurationMs,
    if(isNotNull(getSubcolumn(data_json, 'timeToFirstByteMs')), assumeNotNull(getSubcolumn(data_json, 'timeToFirstByteMs')), 0)::Int64 AS timeToFirstByte,
    if(isNotNull(getSubcolumn(data_json, 'cpuTimeMicroseconds')), assumeNotNull(getSubcolumn(data_json, 'cpuTimeMicroseconds')) / 1000, -1)::Int64 AS cpuTime,
    if(isNotNull(getSubcolumn(data_json, 'newCpuTime')), assumeNotNull(getSubcolumn(data_json, 'newCpuTime')), -1)::Int64 AS newCpuTime,

    -1::Int64 AS cpuTimeInit,
    -1::Int64 AS throttledDuration,
    -1::Int32 AS lambdaMemorySize,
    -1::Int32 AS maxMemoryUsed,
    -1::Int32 AS billedDurationMs,
    -1::Int32 AS waitUntilDurationMs,

    -- Internal/Debugging Fields
    toLowCardinality('') AS errorCategory,
    toLowCardinality('') AS framework,
    '' AS frameworkVersion,
    assumeNotNull(getSubcolumn(data_json, 'functionName')) AS lambdaName,
    if(isNotNull(getSubcolumn(data_json, 'n1mc')), assumeNotNull(getSubcolumn(data_json, 'n1mc')), 0)::UInt8 AS n1mc,
    if(isNotNull(getSubcolumn(data_json, 'timeToHandler')), assumeNotNull(getSubcolumn(data_json, 'timeToHandler')), -1)::Int32 AS timeToHandler,
    -1::Int32 AS rustyTimeToHandler,
    if(isNotNull(getSubcolumn(data_json, 'isAdditionalRequest')), assumeNotNull(getSubcolumn(data_json, 'isAdditionalRequest')), 0)::UInt8 AS isAdditionalRequest,
    if(isNotNull(getSubcolumn(data_json, 'concurrency')), assumeNotNull(getSubcolumn(data_json, 'concurrency')), 1)::UInt8 AS concurrency,
    if(isNotNull(getSubcolumn(data_json, 'maxConcurrency')), assumeNotNull(getSubcolumn(data_json, 'maxConcurrency')), 1)::UInt8 AS maxConcurrency,
    toLowCardinality(getSubcolumn(data_json, 'bridgeVersion')) AS bridgeVersion,
    if(isNotNull(getSubcolumn(data_json, 'totalRequests')), assumeNotNull(getSubcolumn(data_json, 'totalRequests')), 1)::UInt16 AS totalRequests,
    getSubcolumn(data_json, 'invocationId') AS invocationId,
    getSubcolumn(data_json, 'instanceId') AS instanceId,
    if(
      isNotNull(getSubcolumn(data_json, 'coldStartDurationMs')), toInt32(assumeNotNull(getSubcolumn(data_json, 'coldStartDurationMs'))), -1
    ) AS coldStartDurationMs,
    getSubcolumn(data_json, 'lambdaRequestId') AS lambdaRequestId

FROM Vercel_Shared.hfi_usage_facts_edge_worker_response where at >= '2025-06-20 19:00:00'
