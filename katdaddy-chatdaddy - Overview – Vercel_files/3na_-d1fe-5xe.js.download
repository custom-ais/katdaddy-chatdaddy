          audioInputTokens Nullable(Int64),
          videoInputTokens Nullable(Int64),
          audioOutputTokens Nullable(Int64),
          audioOutputTokensCost Nullable(String),
          audioOutputTokensCostCurrency String,
          webSearchCallCount Nullable(Int64),
          googleMapsSearchCallCount Nullable(Int64),
          gatewayToolCallCount Nullable(Int64),
          gatewayToolCallCost Nullable(String),
