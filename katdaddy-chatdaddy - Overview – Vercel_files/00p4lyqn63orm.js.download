          .investigation-block-agent-indicator-dot {
            animation: investigationBlockAgentRipple 2s infinite ease-in-out;
            fill: var(--ds-gray-alpha-500);
            transition: fill 0.3s ease-in-out, filter 0.3s ease-in-out;
          }

          .investigation-block-agent-indicator-dot-5 {
            animation-delay: 0s;
          }

          .investigation-block-agent-indicator-dot-4,
          .investigation-block-agent-indicator-dot-6 {
            animation-delay: 0.16s;
          }

          .investigation-block-agent-indicator-dot-2,
          .investigation-block-agent-indicator-dot-3,
          .investigation-block-agent-indicator-dot-8,
          .investigation-block-agent-indicator-dot-9 {
            animation-delay: 0.3s;
          }

          .investigation-block-agent-indicator-dot-1,
          .investigation-block-agent-indicator-dot-7,
          .investigation-block-agent-indicator-dot-10 {
            animation-delay: 0.41s;
            animation-timing-function: cubic-bezier(.58, 0, .38, .98);
          }

          @keyframes investigationBlockAgentRipple {
            0%, 60%, 100% {
              fill: var(--ds-gray-alpha-400);
              filter: drop-shadow(0 0 0 transparent);
            }

            30% {
              fill: var(--ds-gray-alpha-1000);
              filter: drop-shadow(0 0 1.5px rgba(23, 23, 23, 0.2));
            }
          }

          @media (prefers-reduced-motion: reduce) {
            .investigation-block-agent-indicator-dot {
              animation: none;
              filter: none;
            }
          }
        `})]})}])},7934503,e=>{var t=e.i(8465032),r=e.i(6963706);let i={height:16,aspectRatio:1,viewBox:"0 0 16 16"},n=(0,t.jsx)(t.Fragment,{children:(0,t.jsx)("path",{fill:"currentColor",fillRule:"evenodd",d:"M9.75 1H9v1.5h3.44L9.47 5.47 8.94 6 10 7.06l.53-.53 2.97-2.97V7H15V2a1 1 0 0 0-1-1zM2.5 12.44V9H1v5a1 1 0 0 0 1 1h5v-1.5H3.56l2.97-2.97.53-.53L6 8.94l-.53.53z",clipRule:"evenodd"})});e.s(["f",0,function(e){return(0,t.jsx)(r.f,{$generated:i,...e,children:n})}])},6905047,e=>{var t=e.i(8465032),r=e.i(6963706);let i={height:16,aspectRatio:1,viewBox:"0 0 16 16"},n=(0,t.jsx)(t.Fragment,{children:(0,t.jsx)("path",{fill:"currentColor",fillRule:"evenodd",d:"m2.73 1.09.19.72c.22.88.67 1.67 1.27 2.3A4.7 4.7 0 0 1 8 2c1.53 0 2.9.82 3.81 2.11a5 5 0 0 0 1.28-2.3l.18-.72 1.46.37-.2.73a6.8 6.8 0 0 1-1.99 3.3A7 7 0 0 1 13 8h1.5v1.5h-1.66a7 7 0 0 1-.81 2.05l1.56.78.41.2V15h-1.5v-1.54l-1.44-.72A4.5 4.5 0 0 1 8 14a4.5 4.5 0 0 1-3.06-1.26l-1.44.72V15H2v-2.46l.41-.21 1.56-.78q-.56-.91-.81-2.05H1.5V8H3a7 7 0 0 1 .46-2.5 6.8 6.8 0 0 1-2-3.31l-.18-.73zM4.5 8q0-.87.22-1.6 1.16.65 2.53.8v5.19C5.82 11.96 4.5 10.35 4.5 8m4.25 4.39c1.43-.43 2.75-2.04 2.75-4.39q0-.87-.22-1.6a7 7 0 0 1-2.53.8zM8 5.75c.96 0 1.86-.26 2.63-.7A3.3 3.3 0 0 0 8 3.5c-.95 0-1.95.56-2.63 1.54q1.17.7 2.63.71",clipRule:"evenodd"})});e.s(["f",0,function(e){return(0,t.jsx)(r.f,{$generated:i,...e,children:n})}])},2287717,e=>{var t=e.i(8465032),r=e.i(6963706);let i={height:16,aspectRatio:1,viewBox:"0 0 16 16"},n=(0,t.jsx)(t.Fragment,{children:(0,t.jsx)("path",{fill:"currentColor",fillRule:"evenodd",d:"m3.94 9.25.53-.53L7.29 5.9a1 1 0 0 1 1.42 0l2.82 2.82.53.53L11 10.31l-.53-.53L8 7.31 5.53 9.78l-.53.53z",clipRule:"evenodd"})});e.s(["f",0,function(e){return(0,t.jsx)(r.f,{$generated:i,...e,children:n})}])},6564230,e=>{var t=e.i(8465032),r=e.i(6963706);let i={height:16,aspectRatio:1,viewBox:"0 0 16 16"},n=(0,t.jsx)(t.Fragment,{children:(0,t.jsx)("path",{fill:"currentColor",d:"M5 2.44C5 1.02 6.6.2 7.77 1.02l1.5 1.07c.46.33.73.