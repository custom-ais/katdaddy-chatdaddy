atic/connex/figma.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Figma",serviceUrl:"https://www.figma.com",docUrl:"https://developers.figma.com/docs/rest-api/oauth-apps/",oauthSettingsUrl:"https://www.figma.com/developers/apps",oauth:{authorization_endpoint:"https://www.figma.com/oauth",token_endpoint:"https://api.figma.com/v1/oauth/token",token_endpoint_auth_methods_supported:["client_secret_basic"],code_challenge_methods_supported:["S256"]}},additionalInstructions:"Add the redirect URL on the app’s **OAuth credentials** page. The Client Secret is shown only once, when the app is created."}]},{type:"vercel",service:"vercel",label:"Vercel",description:"Vercel platform APIs and MCP server",icon:"/static/connex/vercel.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Vercel",label:"OAuth 2.0",discoveryServerUrl:"https://vercel.com",connectionMethod:"oauth",disableAutoRegistration:!0,serviceUrl:"https://vercel.com",docUrl:"https://vercel.com/docs/sign-in-with-vercel"},{kind:"api-key",name:"Vercel",service:"api.vercel.com",connectionMethod:"api-key",docUrl:"https://vercel.com/docs/rest-api#authentication",instructions:"Create a Vercel Access Token in [Account Settings → Tokens](https://vercel.com/account/tokens) and paste it below. Vercel uses it as a Bearer token for requests to `https://api.vercel.com`."},{kind:"oauth-discovery",name:"Vercel",label:"MCP",discoveryServerUrl:"https://mcp.vercel.com",connectionMethod:"mcp"}]},{type:"resend",service:"resend",label:"Resend",description:"Email for developers",icon:"/static/connex/resend.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Resend",discoveryServerUrl:"https://api.resend.com",serviceUrl:"https://resend.com",docUrl:"https://resend.com/docs/api-reference/oauth/register"},{kind:"oauth-discovery",name:"Resend",label:"MCP",discoveryServerUrl:"https://mcp.resend.com",serviceUrl:"https://resend.com",docUrl:"https://resend.com/docs/mcp-server"},{kind:"api-key",name:"Resend",service:"api.resend.com",docUrl:"https://resend.com/api-keys",instructions:"Create an API key under [Resend → API Keys](https://resend.com/api-keys) and paste it below."}]},{type:"workday",service:"workday",label:"Workday",description:"Workday HR platform",icon:"/static/connex/workday.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Workday",serviceUrl:"https://www.workday.com",docUrl:"https://community.workday.com/sites/default/files/file-hosting/restapi/index.html",oauthTemplate:{authorization_endpoint:"https://{authorization_host}/{tenant}/authorize",token_endpoint:"https://{token_host}/ccx/oauth2/{tenant}/token"},fields:[{key:"tenant",label:"Workday tenant",placeholder:"mycompany",help:"Enter your Workday tenant name, such as mycompany or mycompany_preview."},{key:"authorization_host",label:"Authorization host",placeholder:"impl.workday.com",help:"From the Authorization Endpoint in your Workday View API Clients report, enter the host between https:// and /{tenant}/authorize, such as impl.workday.com or www.myworkday.com."},{key:"token_host",label:"Token host",placeholder:"wd2-impl-services1.workday.com",help:"From the Token Endpoint in View API Clients, enter the host between https:// and /ccx/oauth2/, such as wd2-impl-services1.workday.com; it may differ from the authorization host."}],additionalInstructions:"In Workday, search for Register API Client for Integrations and create a client with Authorization Code Grant. Add the redirect URI as a Redirection URI. Copy the Authorization Endpoint and Token Endpoint from the View API Clients report to fill in the tenant and hosts above."}]},{type:"shopify",service:"shopify",label:"Shopify",description:"Shopify commerce platform",icon:"/static/connex/shopify.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Shopify",serviceUrlTemplate:"https://{store_domain}",docUrl:"https://shopify.dev/docs/apps/build/authentication-authorization/access-tokens/authorization-code-grant",oauthSettingsUrl:"https://dev.shopify.com/dashboard",oauthTemplate:{authorization_endpoint:"https://{store_domain}/admin/oauth/authorize",token_endpoint:"https://{store_domain}/admin/oauth/access_token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["authorization_code"]},fields:[{key:"store_domain",label:"Store domain",placeholder:"your-store.myshopify.com",example:"acme.myshopify.com",help:"Your store’s full myshopify.com domain (e.g. acme.myshopify.com), not just the store name."}],additionalInstructions:"Create the app in the **Shopify Dev Dashboard**. Add the redirect URI under **Allowed redirection URL(s)** in the app configuration."}]},{type:"jira",service:"jira",label:"Jira",description:"Jira issue tracking",icon:"/static/connex/jira.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Jira",serviceUrl:"https://www.atlassian.com/software/jira",docUrl:"https://developer.atlassian.com/cloud/jira/platform/oauth-2-3lo-apps/",oauthSettingsUrl:"https://developer.atlassian.com/console/myapps/",oauth:{issuer:"https://auth.atlassian.com",authorization_endpoint:"https://auth.atlassian.com/authorize?audience=api.atlassian.com&prompt=consent",token_endpoint:"https://auth.atlassian.com/oauth/token",revocation_endpoint:"https://auth.atlassian.com/oauth/revoke",code_challenge_methods_supported:["S256"],token_endpoint_auth_methods_supported:["client_secret_post","client_secret_basic"]}},additionalInstructions:"In the [Atlassian Developer Console](https://developer.atlassian.com/console/myapps/), create an **OAuth 2.0 integration**, then under **Permissions** add the Jira APIs your use case needs so their scopes become available."},{kind:"oauth-discovery",name:"Jira",label:"MCP",discoveryServerUrl:"https://mcp.atlassian.com/v1/mcp/authv2"}]},{type:"jev",service:"jev",label:"Jev",description:"TypeSafe AI decisions, classification, and scoring",icon:"/static/connex/jev.svg",enabled:!0,keywords:["typesafe","typesafe.ai","system one"],methods:[{kind:"api-key",name:"Jev",service:"api.typesafe.ai",docUrl:"https://console.typesafe.ai/keys",instructions:"Create an API key on the [TypeSafe API keys page](https://console.typesafe.ai/keys) and paste the key below. Enter only the key, without the `Bearer` prefix. Use the key in the `Authorization: Bearer <API_KEY>` header when calling the [TypeSafe API](https://docs.typesafe.ai/api)."}]},{type:"sanity",service:"sanity",label:"Sanity",description:"Sanity content platform",icon:"/static/connex/sanity.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"Sanity",serviceUrl:"https://www.sanity.io",docUrl:"https://www.sanity.io/docs/oauth2",oauthSettingsUrl:"https://www.sanity.io/contact/sales?ref=oauth",oauth:{issuer:"https://api.sanity.io",authorization_endpoint:"https://api.sanity.io/v2021-06-07/auth/oauth/authorize",token_endpoint:"https://api.sanity.io/v2021-06-07/auth/oauth/token",userinfo_endpoint:"https://api.sanity.io/v2021-06-07/users/me",grant_types_supported:["authorization_code"]}},additionalInstructions:"Sanity provisions OAuth applications on request — use the link above to ask Sanity for a Client ID and secret. Sanity does not issue refresh tokens, so users re-authenticate once the access token expires."},{kind:"oauth-discovery",name:"Sanity",label:"MCP",discoveryServerUrl:"https://mcp.sanity.io"},{kind:"api-key",name:"Sanity",service:"api.sanity.io",docUrl:"https://www.sanity.io/manage",instructions:"Create a robot token in your project’s [management console](https://www.sanity.io/manage) under Settings → API → Tokens, then paste it below."}]},{type:"bamboohr",service:"bamboohr",label:"BambooHR",description:"BambooHR HR platform",icon:"/static/connex/bamboohr.svg",enabled:!0,methods:[{kind:"oauth-template",name:"BambooHR",serviceUrlTemplate:"https://{subdomain}.bamboohr.com",docUrl:"https://documentation.bamboohr.com/docs/getting-started",oauthSettingsUrl:"https://developers.bamboohr.com/",oauthTemplate:{authorization_endpoint:"https://{subdomain}.bamboohr.com/authorize.php?request=authorize",token_endpoint:"https://{subdomain}.bamboohr.com/token.php?request=token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["authorization_code","refresh_token"]},fields:[{key:"subdomain",label:"Company domain",placeholder:"mycompany",example:"mycompany",help:'The part before .bamboohr.com in your BambooHR URL — if you log in at https://mycompany.bamboohr.com, enter "mycompany".'}],additionalInstructions:"In the [BambooHR Developer Portal](https://developers.bamboohr.com/), click **Add Application**, then open **App details** and add the redirect URI under **Redirect URIs**. Copy the Client ID and Client Secret from the **App Credentials** section."},{kind:"api-key",name:"BambooHR",service:"api.bamboohr.com",docUrl:"https://documentation.bamboohr.com/docs/getting-started",instructions:"In BambooHR, click your name in the lower-left corner, choose **API Keys**, then **Add New Key** and paste the generated key below. Requests use HTTP Basic auth with the key as the username and any value as the password, and every API URL includes your company domain, e.g. `https://api.bamboohr.com/api/gateway.php/{company}/v1/…`."}]},{type:"docusign",service:"docusign",label:"Docusign",description:"Docusign electronic signature and agreement platform",icon:"/static/connex/docusign.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Docusign",serviceUrlTemplate:"https://{account_host}",docUrl:"https://developers.docusign.com/platform/auth/authcode/",oauthSettingsUrl:"https://admin.docusign.com/apps-and-keys",oauthTemplate:{issuer:"https://{account_host}/",authorization_endpoint:"https://{account_host}/oauth/auth",token_endpoint:"https://{account_host}/oauth/token",userinfo_endpoint:"https://{account_host}/oauth/userinfo",jwks_uri:"https://{account_host}/openid-configuration/jwks",grant_types_supported:["authorization_code","refresh_token"]},fields:[{key:"account_host",label:"Docusign account host",placeholder:"account.docusign.com",default:"account.docusign.com",help:"Docusign identity host. Use `account.docusign.com` for production, or `account-d.docusign.com` for the developer sandbox."}],additionalInstructions:"In the Docusign [Apps and Keys](https://admin.docusign.com/apps-and-keys) admin console (or the [developer sandbox](https://admindemo.docusign.com/apps-and-keys) for `account-d.docusign.com`), create an app with **Authorization Code Grant** and add the redirect URI under **Redirect URIs**. Docusign calls the credentials **Integration Key** (Client ID) and **Secret Key** (Client Secret)."}]},{type:"dovetail",service:"dovetail",label:"Dovetail",description:"Dovetail customer intelligence platform",icon:"/static/connex/dovetail.svg",enabled:!0,methods:[{kind:"api-key",name:"Dovetail",service:"dovetail.com",docUrl:"https://developers.dovetail.com/docs/authorization",instructions:"Create a personal API token under [Dovetail → Settings → Account → API](https://dovetail.com/settings/user/account) and paste it below. Tokens expire after 30 days, so you will need to rotate it."}]},{type:"kernel",service:"kernel",label:"Kernel",description:"Kernel cloud browsers for AI agents",icon:"/static/connex/kernel.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Kernel",label:"MCP",discoveryServerUrl:"https://mcp.onkernel.com/mcp"},{kind:"api-key",name:"Kernel",service:"api.onkernel.com",docUrl:"https://dashboard.onkernel.com",instructions:"Create an API key at [Kernel dashboard → API keys](https://dashboard.onkernel.com) and paste it below."}]},{type:"beehiiv",service:"beehiiv",label:"beehiiv",description:"Newsletter publishing, subscriptions, and automations",icon:"/static/connex/beehiiv.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"beehiiv",discoveryServerUrl:"https://mcp.beehiiv.com/mcp",label:"MCP",serviceUrl:"https://www.beehiiv.com",docUrl:"https://www.beehiiv.com/support/article/39255979546263-getting-started-with-the-beehiiv-mcp"},{kind:"oauth",service:{name:"beehiiv",serviceUrl:"https://www.beehiiv.com",docUrl:"https://developers.beehiiv.com/oauth2",oauth:{authorization_endpoint:"https://app.beehiiv.com/oauth/authorize",token_endpoint:"https://app.beehiiv.com/oauth/token",revocation_endpoint:"https://app.beehiiv.com/oauth/revoke",introspection_endpoint:"https://app.beehiiv.com/oauth/introspect"}},additionalInstructions:"beehiiv OAuth clients are not self-serve — contact [beehiiv Support](https://support.beehiiv.com/hc/en-us) to register a client and receive your Client ID and Secret."},{kind:"api-key",name:"beehiiv",service:"api.beehiiv.com",docUrl:"https://developers.beehiiv.com/welcome/create-an-api-key",instructions:"In beehiiv, open **Settings → Workspace Settings → API**, click **Create New API Key**, and paste the key below."}]},{type:"webflow",service:"webflow",label:"Webflow",description:"Manage Webflow CMS, pages, assets and sites",icon:"/static/connex/webflow.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Webflow",discoveryServerUrl:"https://mcp.webflow.com/mcp",label:"MCP",serviceUrl:"https://webflow.com",docUrl:"https://developers.webflow.com/mcp/reference/overview"},{kind:"oauth",service:{name:"Webflow",serviceUrl:"https://webflow.com",docUrl:"https://developers.webflow.com/data/reference/oauth-app",oauthSettingsUrl:"https://webflow.com/dashboard",oauth:{authorization_endpoint:"https://webflow.com/oauth/authorize",token_endpoint:"https://api.webflow.com/oauth/access_token",revocation_endpoint:"https://webflow.com/oauth/revoke_authorization"}},additionalInstructions:"In your Webflow Workspace dashboard, open **Apps & integrations → App Development** and create an app with the **Data Client** building block. Set the redirect URI in the app’s Building Blocks settings — only workspace admins can view the client secret."},{kind:"api-key",name:"Webflow",service:"api.webflow.com",docUrl:"https://developers.webflow.com/data/reference/authentication/site-token",instructions:"Generate a site token under **Site settings → Apps & integrations → API access** and paste it below. For workspace-level access (Enterprise only), generate a workspace token under **Workspace settings → Apps & integrations → Manage → Workspace API access** instead."}]},{type:"datadog",service:"datadog",label:"Datadog",description:"Cloud monitoring and observability",icon:"/static/connex/datadog.svg",enabled:!0,methods:[{kind:"api-key",name:"Datadog",label:"Access token",service:"api.datadoghq.com",connectionMethod:"access-token",docUrl:"https://docs.datadoghq.com/account_management/service-access-tokens/",instructions:"Create a [service access token](https://docs.datadoghq.com/account_management/service-access-tokens/) (or a [personal access token](https://app.datadoghq.com/personal-settings/access-tokens)) and paste it below. Connect sends it as a Bearer token. If your Datadog site is not US1, change **Service** from `api.datadoghq.com` to that site’s API host."},{kind:"api-key",name:"Datadog",label:"API key",service:"api.datadoghq.com",connectionMethod:"api-key",docUrl:"https://docs.datadoghq.com/account_management/api-app-keys/",instructions:"Create an [API key](https://app.datadoghq.com/organization-settings/api-keys) and paste it below. For endpoints that also need an application key (including some MCP setups), add an [application key](https://app.datadoghq.com/personal-settings/application-keys) with **Add Another**. If needed, change **Service** from `api.datadoghq.com` to your Datadog site’s API host."}]},{type:"databricks",service:"databricks",label:"Databricks",description:"Data intelligence and lakehouse platform",icon:"/static/connex/databricks.svg",enabled:!0,methods:[{kind:"oauth-template",name:"Databricks",serviceUrlTemplate:"https://{workspace_host}",docUrl:"https://docs.databricks.com/aws/en/dev-tools/auth/oauth-u2m",oauthSettingsUrl:"https://accounts.cloud.databricks.com/",oauthTemplate:{issuer:"https://{workspace_host}/oidc",authorization_endpoint:"https://{workspace_host}/oidc/v1/authorize",token_endpoint:"https://{workspace_host}/oidc/v1/token"},fields:[{key:"workspace_host",label:"Workspace host",placeholder:"dbc-a1b2c3-d4e5.cloud.databricks.com",help:"Your Databricks workspace hostname without https://, such as dbc-a1b2c3-d4e5.cloud.databricks.com (AWS), adb-1234567890123456.7.azuredatabricks.net (Azure), or 1234567890123456.7.gcp.databricks.com (GCP)."}],additionalInstructions:"Open your Databricks **account console** (`accounts.cloud.databricks.com` for AWS, `accounts.azuredatabricks.net` for Azure, `accounts.gcp.databricks.com` for GCP) and go to **Settings → App connections → Add connection**. Add the redirect URI above, enable **Generate a client secret**, and save. Copy the resulting client ID and secret into the form."}]},{type:"n8n",service:"n8n",label:"n8n",description:"n8n workflow automation",icon:"/static/connex/n8n.svg",enabled:!0,methods:[{kind:"api-key",name:"n8n",service:"n8n.cloud",docUrl:"https://docs.n8n.io/api/authentication/",instructions:"In your n8n instance, open **Settings → n8n API**, click **Create an API key**, and paste the key below. Requests use the `X-N8N-API-KEY` header and must target your instance base URL — e.g. `https://{subdomain}.app.n8n.cloud/api/v1` for n8n Cloud, or `https://{your-host}/api/v1` for self-hosted."}]},{type:"fathom",service:"fathom",label:"Fathom",description:"AI meeting notes and transcripts",icon:"/static/connex/fathom.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Fathom",label:"MCP",discoveryServerUrl:"https://api.fathom.ai/mcp",serviceUrl:"https://fathom.video",docUrl:"https://developers.fathom.ai/api-overview"},{kind:"api-key",name:"Fathom",service:"api.fathom.ai",docUrl:"https://developers.fathom.ai/quickstart",instructions:"In Fathom, open [Settings](https://fathom.video/settings), scroll to **API Access**, click **Add → Generate API Key**, and paste the key below. Fathom expects the key in the `X-Api-Key` header on requests to `https://api.fathom.ai/external/v1`."}]},{type:"npm",service:"npm",label:"npm",description:"JavaScript package registry",icon:"/static/connex/npm.svg",enabled:!0,methods:[{kind:"api-key",name:"npm",service:"registry.npmjs.org",connectionMethod:"access-token"},{kind:"api-key",name:"npm",service:"registry.npmjs.org",connectionMethod:"web-login"}]},{type:"whoop",service:"whoop",label:"WHOOP",description:"WHOOP wearable recovery, sleep, strain, and workout data",icon:"/static/connex/whoop.svg",enabled:!0,methods:[{kind:"oauth",service:{name:"WHOOP",serviceUrl:"https://www.whoop.com",docUrl:"https://developer.whoop.com/docs/developing/oauth/",oauthSettingsUrl:"https://developer-dashboard.whoop.com/apps/create",oauth:{issuer:"https://api.prod.whoop.com/oauth/",authorization_endpoint:"https://api.prod.whoop.com/oauth/oauth2/auth",token_endpoint:"https://api.prod.whoop.com/oauth/oauth2/token",userinfo_endpoint:"https://api.prod.whoop.com/oauth/userinfo",jwks_uri:"https://api.prod.whoop.com/oauth/.well-known/jwks.json",revocation_endpoint:"https://api.prod.whoop.com/oauth/oauth2/revoke",end_session_endpoint:"https://api.prod.whoop.com/oauth/oauth2/sessions/logout",grant_types_supported:["authorization_code","refresh_token"]}},additionalInstructions:"Create a Team in the [WHOOP Developer Dashboard](https://developer-dashboard.whoop.com) before your first app — an app cannot be created without at least one scope and one redirect URI. WHOOP only issues a refresh token when the `offline` scope is requested."}]},{type:"tinybird",service:"tinybird",label:"Tinybird",description:"Query your Tinybird pipes and data sources",icon:"/static/connex/tinybird.svg",enabled:!0,methods:[{kind:"api-key",name:"Tinybird",service:"api.tinybird.co",docUrl:"https://cloud.tinybird.co/tokens",instructions:"Copy a token from [Tinybird → Tokens](https://cloud.tinybird.co/tokens) and paste it below. Tokens are scoped to one Workspace, so add a connector per Workspace you need. If your token predates regional hosts, use your region host instead, such as `https://api.us-east.tinybird.co`."}]},{type:"algolia",service:"algolia",label:"Algolia",description:"Algolia search and discovery",icon:"/static/connex/algolia.svg",enabled:!0,methods:[{kind:"api-key",name:"Algolia",service:"algolia.com",docUrl:"https://dashboard.algolia.com/account/api-keys",instructions:"Create an API key under [Algolia → Settings → API Keys](https://dashboard.algolia.com/account/api-keys) and paste it below. Keys are scoped to one Application, so add a connector per Application you need."}]},{type:"agentcard",service:"agentcard",label:"Agentcard",description:"Virtual cards for AI agents and the Purchase API",icon:"/static/connex/agentcard.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Agentcard",label:"MCP",discoveryServerUrl:"https://mcp.agentcard.sh/mcp",docUrl:"https://docs.agentcard.sh/tools/mcp"}]},{type:"zernio",service:"zernio",label:"Zernio",description:"Social publishing, analytics, and ads across 16 platforms",icon:"/static/connex/zernio.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Zernio",label:"MCP",discoveryServerUrl:"https://mcp.zernio.com/mcp",docUrl:"https://docs.zernio.com/mcp"}]},{type:"agentmail",service:"agentmail",label:"AgentMail",description:"Email inboxes for AI agents",icon:"/static/connex/agentmail.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"AgentMail",label:"MCP",discoveryServerUrl:"https://mcp.agentmail.to/mcp",serviceUrl:"https://agentmail.to",docUrl:"https://docs.agentmail.to/integrations/mcp",additionalInstructions:"Sign up at [console.agentmail.to](https://console.agentmail.to) first — the flow authenticates against your Console identity. If you belong to more than one AgentMail organization, you will be asked to pick one."},{kind:"api-key",name:"AgentMail",service:"api.agentmail.to",docUrl:"https://console.agentmail.to",instructions:"Create a key under [AgentMail Console → Settings → API Keys](https://console.agentmail.to) and paste it below. Keys start with `am_` and are shown only once."}]},{type:"x",service:"x",label:"X",description:"Read and create posts, manage DMs, and access user data.",icon:"/static/connex/x.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"X",discoveryServerUrl:"https://api.x.com",serviceUrl:"https://x.com",docUrl:"https://docs.x.com/fundamentals/authentication/oauth-2-0",oauthSettingsUrl:"https://developer.x.com/en/portal/projects-and-apps",additionalInstructions:"Under **Apps > [Your App] > OAuth 2.0 Keys**, click the **Set up** button next to **User authentication settings**. Set the permissions, app type, and add the redirect URI below."}],keywords:["twitter","tweets"]},{type:"twilio",service:"twilio",label:"Twilio",description:"Cloud communications platform for voice, SMS, and video",icon:"/static/connex/twilio.svg",enabled:!0,methods:[{kind:"oauth",label:"Organization OAuth",service:{name:"Twilio",serviceUrl:"https://www.twilio.com",docUrl:"https://www.twilio.com/docs/iam/oauth-apps/org-oauth-apps",oauthSettingsUrl:"https://1console.twilio.com/",oauth:{authorization_endpoint:"https://oauth.twilio.com/v2/authorize",token_endpoint:"https://oauth.twilio.com/v2/token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["authorization_code","client_credentials","refresh_token"]}},additionalInstructions:"Create an Organization OAuth app under **Settings > Organization settings > Organization API access**."},{kind:"oauth",label:"Account OAuth",service:{name:"Twilio",serviceUrl:"https://www.twilio.com",docUrl:"https://www.twilio.com/docs/iam/oauth-apps/account-oauth-apps",oauthSettingsUrl:"https://1console.twilio.com/",oauth:{authorization_endpoint:"https://oauth.twilio.com/v2/authorize",token_endpoint:"https://oauth.twilio.com/v2/token",token_endpoint_auth_methods_supported:["client_secret_post"],grant_types_supported:["client_credentials"]}},additionalInstructions:"Create an Account OAuth app under **Settings > Account settings > OAuth applications**."}],keywords:["sms","voice","messaging","sendgrid"]},{type:"exa",service:"exa",label:"Exa",description:"Web search API for AI agents",icon:"/static/connex/exa.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Exa",label:"MCP",discoveryServerUrl:"https://mcp.exa.ai/mcp",serviceUrl:"https://exa.ai",docUrl:"https://docs.exa.ai/reference/exa-mcp"},{kind:"api-key",name:"Exa",service:"api.exa.ai",docUrl:"https://dashboard.exa.ai/api-keys",instructions:"Create an API key at [Exa → API Keys](https://dashboard.exa.ai/api-keys) and paste it below."}]},{type:"airtable",service:"airtable",label:"Airtable",description:"Airtable bases, tables, and records",icon:"/static/connex/airtable.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Airtable",discoveryServerUrl:"https://mcp.airtable.com/mcp",label:"MCP"}]},{type:"asana",service:"asana",label:"Asana",description:"Connect to Asana to coordinate tasks, projects, and goals",icon:"/static/connex/asana.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Asana",discoveryServerUrl:"https://mcp.asana.com/v2/mcp",label:"MCP",disableAutoRegistration:!0,oauthSettingsUrl:"https://app.asana.com/0/my-apps",docUrl:"https://developers.asana.com/docs/integrating-with-asanas-mcp-server",additionalInstructions:'Create the app in the Asana developer console and pick the "MCP app" type.'}]},{type:"bitly",service:"bitly",label:"Bitly",description:"Shorten links, generate QR Codes, and track performance",icon:"/static/connex/bitly.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Bitly",discoveryServerUrl:"https://api-ssl.bitly.com/v4/mcp",label:"MCP"}]},{type:"box",service:"box",label:"Box",description:"Search, edit and get insights on your Box content",icon:"/static/connex/box.svg",enabled:!0,methods:[{kind:"oauth-discovery",name:"Box",discoveryServerUrl:"https://mcp.box.com",label:"MCP",disableAutoRegistration:!0,oauthSettingsUrl:"https://app.box.com/developers/console",docUrl:"https://developer.box.com/guides/box-mcp/remote/",additionalInstructions:"Box documents MCP credentials under Admin Console > Integr