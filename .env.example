# Copy to .env for local runs. On Vercel, add these as Project Environment Variables.
# Never commit real values.

# --- Database (any one of these) ---
# Uses the existing ChatDaddy Supabase project through its service key:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or a direct Postgres connection string:
# DATABASE_URL=

# --- Office dashboard ---
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=https://katdaddy-bookingbot.vercel.app
# BOB_SETUP_TOKEN=            # only if ADMIN_PASSWORD is not set

# --- Jobber (redirect URI: <app url>/api/jobber/callback) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=

# --- LeadConnector: verification codes, confirmations, approver texts ---
LC_PRIVATE_TOKEN=
LC_LOCATION_ID=
# LC_FROM_NUMBER=
# LC_EMAIL_FROM=

# --- Appointment emails and the 5:10 PM Arizona activity report ---
# Google Workspace: use an app password, never the mailbox login password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=westvalley@dryerventsquad.com
SMTP_PASSWORD=
EMAIL_FROM=westvalley@dryerventsquad.com
EMAIL_REPLY_TO=westvalley@dryerventsquad.com
DAILY_REPORT_TO=westvalley@dryerventsquad.com
DAILY_REPORT_CC=seth@custom-ais.com
CRON_SECRET=
# Random 32-byte base64 or 64-character hex encryption key; keep in Vercel only.
# Required to save API keys securely through the admin dashboard. Keep stable across deployments.
BOB_SECRET_KEY=

# --- Smart chat (Gemini). Rotate any key that was ever pasted into a file or chat. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Real drive times (optional; straight-line estimates without it) ---
# GOOGLE_MAPS_API_KEY=
