# Copy to .env for local runs. On Vercel, add these as Project Environment Variables.
# Never commit real values.

# --- Database (any one of these) ---
# Uses the existing ChatDaddy Supabase project through its service key:
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# or a direct Postgres connection string:
# DATABASE_URL=

# --- Office dashboard ---
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=https://katdaddy-bookingbot.vercel.app
# BOB_SETUP_TOKEN=            # only if ADMIN_PASSWORD is not set

# --- Jobber (redirect URI: <app url>/api/jobber/callback) ---
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=

# --- LeadConnector: verification codes, confirmations, approver texts ---
LC_PRIVATE_TOKEN=
LC_LOCATION_ID=
# LC_FROM_NUMBER=
# LC_EMAIL_FROM=

# --- Smart chat (Gemini). Rotate any key that was ever pasted into a file or chat. ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- Real drive times (optional; straight-line estimates without it) ---
# GOOGLE_MAPS_API_KEY=

# --- Optional Twilio providers (server-only; explicitly opt in) ---
# Select explicitly only after reviewing/configuring the matching provider.
# BOOKING_VERIFICATION_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_API_KEY_SID=
# TWILIO_API_KEY_SECRET=
# TWILIO_VERIFY_SERVICE_SID=
# Verify service must use 4-digit codes (Code length = 4), with Email channel + SendGrid mailer attached.
# SendGrid's Verify mailer does not send appointment confirmations.
# Ordinary texting is separately enabled only with an approved sender:
# BOOKING_SMS_PROVIDER=twilio
# TWILIO_MESSAGING_SERVICE_SID=
# TWILIO_SMS_SENDER_APPROVED=false

# --- Owner-only ordinary SMS (server-only; off unless exactly the string true) ---
# SMS_OWNER_ALERTS_ONLY=true
# Suppresses customer confirmation SMS, approver SMS, and staff early-availability SMS.
# Approver email continues; availability requests are still captured for the team.
# Public textMessages is false. Twilio Verify and owner booking/error SMS are unaffected.
# Owner SMS still requires current v2 consent for the configured owner phone,
# its separate enabled setting, and an approved/configured ordinary-SMS provider.
# See TWILIO-SETUP.md and the owner campaign entry checklist Part 4 before activation.
